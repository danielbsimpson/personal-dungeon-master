# ─── LLM Provider ────────────────────────────────────────────────────────────
# Which LLM backend to use. Only "llamacpp" is supported right now;
# external cloud providers are planned for a later phase.
LLM_PROVIDER=llamacpp

# ─── llama.cpp ───────────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=llamacpp
# Default: http://localhost:8080
# Start the server: llama-server -m path/to/model.gguf -c 4096
LLAMACPP_BASE_URL=http://localhost:8080

# ─── Model ───────────────────────────────────────────────────────────────────
# The model to use for the DM agent.
# Use the model ID shown by the llama.cpp server (typically the .gguf path or alias).
# Leave blank to auto-detect from the running server.
DM_MODEL=

# ─── Rules ───────────────────────────────────────────────────────────────────
# Which game edition rules to load from the rules/ directory.
# Default: 5e
GAME_EDITION=5e

# ─── Directories ─────────────────────────────────────────────────────────────
# Paths are relative to the project root unless absolute.
# Leave blank to use the defaults shown below.
CAMPAIGNS_DIR=campaigns
MEMORY_DIR=memory
RULES_DIR=rules

# ─── Memory / Graphiti ───────────────────────────────────────────────────────
# Number of most-recent messages to keep in the short-term session window.
SESSION_WINDOW=20

# Embedding model for Graphiti entity embeddings
# Run a dedicated llama.cpp embedding server: llama-server -m nomic-embed-text.gguf --embedding
EMBEDDING_MODEL=nomic-embed-text

# Embedding vector dimension — must match the model above.
# nomic-embed-text = 768  |  mxbai-embed-large = 1024  |  text-embedding-3-small = 1536
EMBEDDING_DIM=768

# Set to false to opt out of Graphiti/Zep anonymous usage telemetry.
GRAPHITI_TELEMETRY_ENABLED=false

# ─── Voice interface (Phase 14) ──────────────────────────────────────────────
# Requires the optional voice dependencies: pip install -r requirements-voice.txt
# Launch a voice session with: python -m src.main --voice

# Kokoro TTS voice persona for the DM. American voices start with 'a' (af_/am_),
# British with 'b'. Examples: af_heart, af_bella, am_michael, bm_george.
TTS_VOICE=af_heart

# Kokoro language code: 'a' = American English, 'b' = British English.
TTS_LANG_CODE=a

# Playback speed multiplier for DM speech (1.0 = normal).
TTS_SPEED=1.0

# faster-whisper model size: tiny | base | small | medium | large-v3
# Larger = more accurate but slower. 'base' is a good balance on CPU.
STT_MODEL=base

# Device for speech-to-text: cpu | cuda
STT_DEVICE=cpu

# faster-whisper compute type: int8 (CPU) | float16 (GPU) | int8_float16
STT_COMPUTE_TYPE=int8

# Microphone capture sample rate in Hz (Whisper expects 16000).
VOICE_SAMPLE_RATE=16000
